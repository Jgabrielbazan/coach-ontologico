# Copiá este archivo como .env y completá tu clave.
# La clave NUNCA llega al navegador: el servidor la usa para crear tokens temporales.

# Clave de Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Contraseña para entrar a la app. Obligatoria si la abrís desde el móvil
# o la publicás en internet; podés dejarla vacía si solo la usás en tu PC.
APP_PASSWORD=

# Opcionales
# PORT=3000
# GEMINI_MODEL=gemini-3.8-live
# GEMINI_VOICE=Kore
# Milisegundos de silencio antes de que el coach responda (pausas reflexivas)
# SILENCIO_MS=1500
