{
  "name": "coach-ontologico",
  "version": "0.1.0",
  "private": true,
  "description": "Coach ontológico por voz en tiempo real (Gemini Live). App personal para PC y móvil.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "vite",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/genai": "^2.29.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "vite": "^7.1.0"
  }
}
